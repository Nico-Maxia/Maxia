# Configuration du serveur
NODE_ENV=development
PORT=3000
API_VERSION=v1
CORS_ORIGIN=http://localhost:3001

# Configuration de la base de données PostgreSQL
DATABASE_URL="postgresql://user:password@localhost:5432/maxia_db?schema=public"

# Configuration JWT
JWT_SECRET=votre_secret_tres_long_et_complexe
JWT_EXPIRES_IN=24h
JWT_REFRESH_SECRET=votre_second_secret_tres_long_et_complexe
JWT_REFRESH_EXPIRES_IN=7d

# Configuration Mailjet
MJ_APIKEY_PUBLIC=votre_cle_publique_mailjet
MJ_APIKEY_PRIVATE=votre_cle_privee_mailjet
MAIL_FROM=admin@votredomaine.com
MAIL_FROM_NAME="Maxia Admin"

# Configuration des logs
LOG_LEVEL=debug
LOG_FILE_PATH=logs/admin.log
MAX_LOG_SIZE=10m
MAX_LOG_FILES=7

# Redis (pour la gestion des sessions et du cache)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=votre_mot_de_passe_redis

# Sécurité
BCRYPT_SALT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100