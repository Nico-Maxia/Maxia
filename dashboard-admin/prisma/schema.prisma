// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  name      String
  role      Role     @default(USER)
  company   Company? @relation(fields: [companyId], references: [id])
  companyId Int?
  license   License? @relation("LicenseUser")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Company {
  id        Int       @id @default(autoincrement())
  name      String
  address   String?
  phone     String?
  users     User[]
  licenses  License[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model License {
  id           Int          @id @default(autoincrement())
  key          String       @unique
  employeeName String
  email        String
  type         LicenseType  @default(TRIAL)
  status       LicenseStatus @default(ACTIVE)
  expiryDate   DateTime?
  active       Boolean      @default(true)
  user         User?        @relation("LicenseUser", fields: [userId], references: [id])
  userId       Int?         @unique
  company      Company      @relation(fields: [companyId], references: [id])
  companyId    Int
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

model FlowExecution {
  id        Int      @id @default(autoincrement())
  flowName  String
  userId    Int
  success   Boolean
  duration  Int // durée en secondes
  createdAt DateTime @default(now())
}

enum Role {
  ADMIN
  MANAGER
  USER
}

enum LicenseType {
  TRIAL
  UNLIMITED
}

enum LicenseStatus {
  ACTIVE
  EXPIRED
  SUSPENDED
  INACTIVE
} 