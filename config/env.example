# Variables d'environnement communes pour la base de données
DATABASE_URL="postgresql://user:password@localhost:5432/maxia?schema=public"

# Configuration de sécurité commune
JWT_SECRET=your_jwt_secret
JWT_EXPIRES_IN=1d

# API Mailjet (commune)
MAILJET_API_KEY=your_mailjet_api_key
MAILJET_SECRET_KEY=your_mailjet_secret_key

# Stripe (commun)
STRIPE_API_KEY=your_stripe_api_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret

# Configuration du serveur Admin Backend
ADMIN_API_PORT=3001
ADMIN_NODE_ENV=development
ADMIN_API_VERSION=v1
ADMIN_CORS_ORIGIN=http://localhost:3003

# Configuration du serveur Admin Frontend
ADMIN_FRONTEND_PORT=3003

# Configuration du serveur Client Backend
CLIENT_API_PORT=3002
CLIENT_NODE_ENV=development
CLIENT_API_VERSION=v1
CLIENT_CORS_ORIGIN=http://localhost:3004

# Configuration du serveur Client Frontend
CLIENT_FRONTEND_PORT=3004

# Configuration du site web
WEBSITE_PORT=3000

# Configuration de l'extension
EXTENSION_API_URL=http://localhost:3002/api/v1 